<!--
  Wazuh Agent (Windows) - Custom File Integrity Monitoring configuration
  Added to the Windows agent's ossec.conf (via Wazuh Dashboard agent config / local ossec.conf)
-->

<syscheck>
  <disabled>no</disabled>
  <frequency>300</frequency>
  <alert_new_files>yes</alert_new_files>

  <!-- Custom test directory monitored in real-time to validate FIM detection
       (used alongside the Ubuntu agent's /root monitoring for cross-platform testing) -->
  <directories check_all="yes" realtime="yes" report_changes="yes">C:\test-fim</directories>
</syscheck>
